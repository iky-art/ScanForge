# Frontend (Vite) — exposed to browser, must only ever be the anon/public key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend (api/*.ts Vercel Functions) — these run server-side only and are
# never bundled into the frontend. Set them in your Vercel project's
# Environment Variables (dashboard, or `vercel env add`), not just here.
SCAN_REQUEST_TIMEOUT_MS=10000
SCAN_MAX_REDIRECTS=5
SCAN_MAX_RESPONSE_BYTES=5000000

# AI Scanner (v2.0.0) — points to your Val Town Gemini proxy val. The
# actual Gemini API key lives only on Val Town, never here.
VAL_TOWN_AI_URL=https://your-username--your-val-id.web.val.run
