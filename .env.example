# Frontend (Vite) — exposed to browser, must only ever be the anon/public key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_BASE_URL=http://localhost:8787

# Backend (server/) — never exposed to the frontend bundle
PORT=8787
CORS_ORIGIN=http://localhost:5173
SCAN_REQUEST_TIMEOUT_MS=10000
SCAN_MAX_REDIRECTS=5
SCAN_MAX_RESPONSE_BYTES=5000000
